# Airflow image and UID
AIRFLOW_IMAGE_NAME=apache/airflow:3.0.0
AIRFLOW_UID=50000

# --- Secrets (generate fresh values before first run) ---
# Generate a Fernet key:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME

# Generate random base64 keys:  python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(16)).decode())"
AIRFLOW__CORE__INTERNAL_API_SECRET_KEY=CHANGE_ME
AIRFLOW__API_AUTH__JWT_SECRET=CHANGE_ME
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME

# Airflow web UI admin credentials
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME
